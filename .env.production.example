# Copia este archivo como .env.production y reemplaza todos los valores CHANGE_ME.
FRONTEND_PORT=8095

POSTGRES_USER=scrapingweb
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=scrapingweb

# El navegador usa /api en el mismo origen; no se publica el puerto del backend.
BACKEND_CORS_ORIGINS=http://scrapingweb.site:8095,http://www.scrapingweb.site:8095
JWT_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=120

INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=CHANGE_ME@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

SCRAPPING_SCHEDULE_DAY=sun
SCRAPPING_SCHEDULE_HOUR=22
SCRAPPING_SCHEDULE_MINUTE=0
SCRAPPING_SCHEDULE_TIMEZONE=America/Bogota
SCRAPPING_RUN_ON_STARTUP=false
SCRAPPING_SCRIPT_TIMEOUT_SECONDS=0
